		sourceColumn: [DayName]

		annotation SummarizationSetBy = Automatic

	partition Dim_Calendar = calculated
		mode: import
		source =
				
				VAR MinYear = YEAR(MIN('fact_sales'[date]))
				VAR MaxYear = YEAR(MAX('fact_sales'[date]))
				RETURN
				ADDCOLUMNS (
				    CALENDAR(DATE(MinYear, 1, 1), DATE(MaxYear, 12, 31)),
				    "DateKey", YEAR([Date]) * 10000 + MONTH([Date]) * 100 + DAY([Date]),
				    "Year", YEAR([Date]),
				    "Period", YEAR([Date]) * 100 + MONTH([Date]),
				    "MonthNo", MONTH([Date]),
				    "MonthName", FORMAT([Date], "MMMM", "en-US"),
				    "MonthShort", FORMAT([Date], "MMM", "en-US"),
				    "Day", DAY([Date]),
				    "DayOfWeekNo", WEEKDAY([Date], 2),
				    "DayName", FORMAT([Date], "dddd", "en-US")
				)

	annotation PBI_Id = 8c92e6df486f4d549c2b7963f84f97f0

